# ============================================
# Applio - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e configure os valores
# cp .env.example .env

# ============================================
# API Settings
# ============================================
# Host onde a API vai rodar (padrão: 0.0.0.0)
API_HOST=0.0.0.0

# Porta da API (padrão: 8000)
API_PORT=8000

# API Key para autenticação (Bearer token)
# Se não configurado, a API será pública
# Gere uma chave segura: openssl rand -base64 32
API_KEY='NSBAGp9G/3/yHAxtrgisH5uWSRsUitQtS7PHOH7vd+I='

# ============================================
# Whisper (Transcrição)
# ============================================
# Tamanho do modelo Whisper
# Opções: turbo, large-v3, large, medium, small, base, tiny
# turbo é o mais rápido e moderno (recomendado)
WHISPER_MODEL_SIZE=turbo

# Pré-carregar Whisper no startup (true/false)
# true = carrega no início (mais rápido nas requisições, mas demora mais para iniciar)
# false = carrega sob demanda (inicia mais rápido, mas primeira requisição é mais lenta)
WHISPER_PRELOAD=true

# ============================================
# Pyannote (Diarização - Opcional)
# ============================================
# Token do Hugging Face para acessar modelos Pyannote
# Obtido em: https://huggingface.co/settings/tokens
# Aceite os termos em: https://huggingface.co/pyannote/speaker-diarization-3.1
# Deixe vazio se não quiser usar diarização
PYANNOTE_TOKEN=

# Pré-carregar diarização no startup (só funciona se PYANNOTE_TOKEN configurado)
PYANNOTE_PRELOAD=true

# Modelo Pyannote (padrão: pyannote/speaker-diarization-3.1)
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1

# ============================================
# GPU Settings (Opcional)
# ============================================
# Controlar quais GPUs usar
# Exemplos:
#   CUDA_VISIBLE_DEVICES=0        # Usar apenas GPU 0
#   CUDA_VISIBLE_DEVICES=0,1      # Usar GPUs 0 e 1
#   CUDA_VISIBLE_DEVICES=         # Usar todas as GPUs disponíveis (padrão)
CUDA_VISIBLE_DEVICES=

# ============================================
# Paths (Opcional)
# ============================================
# Diretório para salvar áudios gerados
# Padrão: assets/audios (relativo ao diretório raiz do Applio)
OUTPUT_DIR='assets/audios'

# Diretório para uploads temporários
# Padrão: assets/uploads (relativo ao diretório raiz do Applio)
UPLOAD_DIR='assets/uploads'

# ============================================
# Docker/Container Settings
# ============================================
# Desabilitar Discord Presence (recomendado em containers)
# true = desabilita tentativa de conectar ao Discord
DISABLE_DISCORD_PRESENCE=1

# Indicar que está rodando em container Docker
# true = container Docker (ajusta comportamentos)
DOCKER_CONTAINER=1

# Buffer do Python (recomendado para containers)
# 1 = sem buffer (logs aparecem imediatamente)
PYTHONUNBUFFERED=1

# ============================================
# Outros Tokens (Opcional)
# ============================================
# Adicione aqui outros tokens conforme necessário
# Exemplos:
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# ANTHROPIC_API_KEY=

# ============================================
# Notas
# ============================================
# - Todas as variáveis são opcionais (têm valores padrão)
# - Variáveis vazias usam os valores padrão
# - Para API_KEY: gere uma chave segura com: openssl rand -base64 32
# - Para PYANNOTE_TOKEN: obtenha em https://huggingface.co/settings/tokens
# - Em produção, use variáveis de ambiente do sistema ou secrets do Docker
